# ==============================================================================
# PayGuard AI — Production Environment Variables (Render Web Service)
# ==============================================================================
# IMPORTANT: Never commit actual secret keys or credentials to Git.
# Set these variables in the Render Dashboard under Web Service -> Environment.
# ==============================================================================

# Runtime Environment
NODE_ENV=production
PORT=10000
STORAGE_DRIVER=postgres

# PostgreSQL Connection String (Provided by Render Managed PostgreSQL)
# Example: postgresql://payguard_user:password@payguard-db:5432/payguard_db?sslmode=require
DATABASE_URL=postgresql://payguard_user:your_db_password@dpg-xxx-a:5432/payguard_db?sslmode=require

# Frontend Integration & CORS (Strict Explicit Origins, No Wildcards)
FRONTEND_URL=https://payguard-frontend.onrender.com
CORS_ORIGIN=https://payguard-frontend.onrender.com

# PayPal Sandbox API (Hackathon Demo Mode)
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret

# Groq LLM API (Intent Parsing)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Tavily Search API (Merchant Discovery)
TAVILY_API_KEY=your_tavily_api_key

