# ==============================================================================
# PayGuard AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env in backend/ or root for local development.
# NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# Backend Service
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# PayPal Orders API Sandbox (Phase 3 Integration — Server-Side Only!)
# ------------------------------------------------------------------------------
# Obtain Sandbox credentials from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# ------------------------------------------------------------------------------
# Groq LLM API (Phase 4.1 Integration — Server-Side Only!)
# ------------------------------------------------------------------------------
# Obtain Groq API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# Tavily Search API (Phase 4.3 Integration — Server-Side Only!)
# ------------------------------------------------------------------------------
# Obtain Tavily API key from: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# PostgreSQL & Storage Configuration (Phase 5.1)
# ------------------------------------------------------------------------------
# Storage driver: "in_memory" (default for zero-setup development) or "postgres"
STORAGE_DRIVER=in_memory

# PostgreSQL Prisma Connection String (Used when STORAGE_DRIVER=postgres)
DATABASE_URL=postgresql://payguard_user:local_dev_password@localhost:5433/payguard_db?schema=public
